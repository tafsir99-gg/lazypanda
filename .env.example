# ─── AI Data Cleaner — Environment Variables ─────────────────────────────────
#
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your real values in .env
#   3. NEVER commit .env to git (it is in .gitignore)
#
# ─── Gemini API ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─── Application ──────────────────────────────────────────────────────────────
# Default output directory for cleaned files and reports
OUTPUT_DIR=./outputs
